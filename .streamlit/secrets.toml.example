# Copy to .streamlit/secrets.toml and fill in. NEVER commit the real file.
#
# On Streamlit Community Cloud these are set in the app's Secrets panel,
# not from this file.

# Chatbot only (Phase 4). The read-only pages need no key — if this is
# missing the app must still render normally and the Ask page must show a
# clear configuration message, not a stack trace (EC-OPS-4 / S4-OPS-4).
OPENAI_API_KEY = "sk-..."

# Gold-set labelling page (9_Label.py) — password-gated (EC-OPS-7)
LABEL_PASSWORD = "choose-something-long"

# --- Pipeline only. Not needed by the deployed app. ---
[reddit]
client_id = ""
client_secret = ""
user_agent = "myntra-discovery-engine/0.1 by u/<your-handle>"

[youtube]
api_key = ""
